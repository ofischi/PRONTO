{
  "name": "pronto-teklif",
  "version": "1.0.1",
  "description": "PRONTO Teklif / Satış",
  "main": "main.js",
  "author": "Ofischi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ofischi.pronto.teklif",
    "productName": "PRONTO Teklif",
    "files": ["main.js", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "PRONTO-Teklif-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PRONTO Teklif"
    },
    "publish": {
      "provider": "github",
      "owner": "ofischi",
      "repo": "PRONTO",
      "releaseType": "draft"
    }
  }
}
