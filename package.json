{
  "name": "pronto",
  "version": "1.0.0",
  "description": "PRONTO Teklif / Satış",
  "main": "main.js",
  "author": "Ofischi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ofischi.pronto",
    "productName": "PRONTO",
    "files": ["main.js", "package.json"],
    "win": { "icon": "build/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "PRONTO-Kurulum-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "PRONTO" },
    "publish": { "provider": "github", "owner": "ofischi", "repo": "PRONTO", "releaseType": "release" }
  }
}
